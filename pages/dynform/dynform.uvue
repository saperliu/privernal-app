}

/* 自绘按钮基类：uni-app x 的 button 组件带默认 ::after 描边（跨端无法去除），统一 view+text 自绘 */
.btn {
	flex: 1;
	height: 46px;
	border-radius: 12px;
	align-items: center;
	justify-content: center;
	margin: 0 5px;
}

.btn-text {
