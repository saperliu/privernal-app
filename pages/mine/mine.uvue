<template>
	<view class="page">
		<view class="profile">
			<view class="avatar">
				<text class="avatar-text">{{shortName}}</text>
			</view>
			<view class="profile-info">
				<text class="nick-name">{{nickName}}</text>
				<text class="login-name">账号：{{loginName}}</text>
			</view>
		</view>

		<view class="group">
			<view class="row">
				<text class="row-label">组织</text>
				<text class="row-value">{{organizationName}}</text>
			</view>
			<view class="row">
				<text class="row-label">部门</text>
				<text class="row-value">{{departmentName}}</text>
			</view>
			<view class="row">
				<text class="row-label">邮箱</text>
				<text class="row-value">{{email}}</text>
			</view>
			<view class="row">
				<text class="row-label">手机号</text>
				<text class="row-value">{{phone}}</text>
			</view>
		</view>

		<view class="group">
			<view class="row row-click" @click="goChangePassword">
				<text class="row-label">修改密码</text>
				<text class="row-arrow">›</text>
			</view>
		</view>

		<view class="logout-wrap">
			<view class="btn-logout" @click="logout">
				<text class="btn-logout-text">退出登录</text>
			</view>
			<view class="btn-cancel-account" @click="cancelAccount">
				<text class="btn-cancel-account-text">注销账号</text>
			</view>
		</view>

		<view class="server-info">
			<text class="server-text">服务器：{{baseUrl}}</text>
		</view>
	</view>
</template>

<script setup lang="uts">
import { http, API_GET_INFO, API_LOGOUT, API_ACCOUNT_CANCEL } from '@/utils/http.uts'
import {
  getUserInfo, setUserInfo, clearToken, clearUserInfo,
  getBaseUrl, isLoggedIn, UserInfo
} from '@/utils/store.uts'

const nickName = ref('未登录')
const loginName = ref('-')
const organizationName = ref('-')
const departmentName = ref('-')
const email = ref('-')
const phone = ref('-')
const shortName = ref('春')
const baseUrl = ref('')

onShow(() => {
  if (!isLoggedIn()) {
    uni.reLaunch({ url: '/pages/login/login' })
    return
  }
  baseUrl.value = getBaseUrl()
  const cached = getUserInfo()
  if (cached != null) {
    applyUser(cached)
  }
  refreshUser()
})

function applyUser(user: UserInfo) {
  nickName.value = user.nickName == '' ? user.loginName : user.nickName
  loginName.value = user.loginName
  organizationName.value = user.organizationName == '' ? '-' : user.organizationName
  departmentName.value = user.departmentName == '' ? '-' : user.departmentName
  email.value = user.email == '' ? '-' : user.email
  phone.value = user.phone == '' ? '-' : user.phone
  shortName.value = nickName.value.substring(0, 1)
}

function refreshUser() {
  http('GET', API_GET_INFO, null, (ok, res, msg) => {
    if (!ok) {
      return
    }
    const data = res?.getJSON('data')
    if (data == null) {
      return
    }
    const roles = data.getArray('roleKeys')
    const user: UserInfo = {
      userId: data.getString('userId') ?? '',
      loginName: data.getString('loginName') ?? loginName.value,
      nickName: data.getString('nickName') ?? nickName.value,
      organizationName: data.getString('organizationName') ?? '',
      organizationId: data.getString('organizationId') ?? '',
      departmentName: data.getString('departmentName') ?? '',
      departmentId: data.getString('departmentId') ?? '',
      email: data.getString('email') ?? '',
      phone: data.getString('phone') ?? '',
      roleKeys: roles == null ? '' : roles.join(',')
    }
    setUserInfo(user)
    applyUser(user)
  })
}

function goChangePassword() {
  uni.navigateTo({
    url: '/pages/change-password/change-password'
  })
}

/**
 * 注销账号：删除该账号及相关数据（后端 auth/account/cancel，不可恢复）。
 * 双重确认：第一次告知后果，第二次最终确认
 */
function cancelAccount() {
  uni.showModal({
    title: '注销账号',
    content: '注销后将删除该账号及相关数据，且不可恢复。确定继续吗？',
    cancelText: '取消',
    confirmText: '继续',
    success: (res) => {
      if (!res.confirm) {
        return
      }
      uni.showModal({
        title: '最终确认',
        content: '账号「' + loginName.value + '」将被删除且无法登录，确定注销吗？',
        cancelText: '取消',
        confirmText: '确认注销',
        success: (res2) => {
          if (!res2.confirm) {
            return
          }
          doCancelAccount()
        }
      })
    }
  })
}

function doCancelAccount() {
  uni.showLoading({ title: '注销中…' })
  http('POST', API_ACCOUNT_CANCEL, null, (ok, res, msg) => {
    uni.hideLoading()
    if (!ok) {
      uni.showToast({ title: msg == '' ? '注销失败' : msg, icon: 'none' })
      return
    }
    clearToken()
    clearUserInfo()
    uni.showToast({ title: '账号已注销', icon: 'none' })
    setTimeout(() => {
      uni.reLaunch({ url: '/pages/login/login' })
    }, 800)
  })
}

function logout() {
  uni.showModal({
    title: '提示',
    content: '确定退出登录吗？',
    cancelText: '取消',
    confirmText: '确定',
    success: (res) => {
      if (!res.confirm) {
        return
      }
      http('DELETE', API_LOGOUT, null, (ok, res2, msg) => {
        clearToken()
        clearUserInfo()
        uni.reLaunch({
          url: '/pages/login/login'
        })
      })
    }
  })
}
</script>

<style>
.page {
	flex: 1;
	background-color: #f4f6fa;
}

.profile {
	flex-direction: row;
	align-items: center;
	background-color: #ffffff;
	padding: 24px 20px;
}

.avatar {
	width: 60px;
	height: 60px;
	border-radius: 30px;
	background-color: #2f6bff;
	align-items: center;
	justify-content: center;
}

.avatar-text {
	color: #ffffff;
	font-size: 24px;
	font-weight: 600;
}

.profile-info {
	margin-left: 16px;
}

.nick-name {
	font-size: 20px;
	font-weight: 700;
	color: #1f2733;
}

.login-name {
	margin-top: 4px;
	font-size: 12px;
	color: #9098a8;
}

.group {
	margin: 14px 16px 0 16px;
	background-color: #ffffff;
	border-radius: 12px;
}

.row {
	flex-direction: row;
	align-items: center;
	padding: 15px 16px;
	border-bottom-width: 0.5px;
	border-bottom-color: #f0f2f7;
	border-bottom-style: solid;
}

.row-click {
	border-bottom-width: 0;
}

.row-label {
	width: 64px;
	font-size: 15px;
	color: #4b5563;
}

.row-value {
	flex: 1;
	font-size: 15px;
	color: #1f2733;
	text-align: right;
}

.row-arrow {
	font-size: 18px;
	color: #c0c6d2;
}

.logout-wrap {
	margin: 30px 16px 0 16px;
}

.btn-logout {
	height: 46px;
	border-radius: 10px;
	background-color: #ffffff;
	align-items: center;
	justify-content: center;
}

.btn-logout-text {
	font-size: 16px;
	color: #f53f3f;
}

.btn-cancel-account {
	margin-top: 12px;
	height: 46px;
	border-radius: 10px;
	background-color: #ffffff;
	align-items: center;
	justify-content: center;
}

.btn-cancel-account-text {
	font-size: 14px;
	color: #9098a8;
}

.server-info {
	margin-top: 16px;
	align-items: center;
}

.server-text {
	font-size: 11px;
	color: #b3bac6;
}
</style>
